#!/usr/bin/env bash
# Refuse a commit that would put the machine, the network or the person into the repository.
# Checks the staged content and who the commit is by; commit-msg checks the message, pre-push
# checks everything that leaves. Enabled for every clone by settings.gradle.kts.
set -u
. "$(git rev-parse --show-toplevel)/.githooks/lib/leakcheck.sh"
warn_if_no_private_patterns

fail=0
report() {
  [ "$fail" -eq 0 ] && echo "The commit was stopped: it carries something that identifies the machine or its owner." >&2
  fail=1
  echo "  $1" >&2
}

for who in AUTHOR COMMITTER; do
  email="$(git var "GIT_${who}_IDENT" | sed -E 's/.*<([^>]*)>.*/\1/')"
  identity_allowed "$email" || report "the $(echo $who | tr A-Z a-z) would be $email, which is not in .githooks/allowed-identities"
done

staged=$(git diff --cached --name-only --diff-filter=ACM)
for f in $staged; do
  case "$f" in
    *hs_err_pid*.log|*replay_pid*.log|core.*|*.hprof)
      report "$f is a crash dump; it carries absolute paths from whoever ran the build." ;;
    secret.properties|*.env|*.pem|*.key|*id_rsa*|local.properties)
      report "$f holds configuration that belongs outside the repository." ;;
  esac
done

for f in $staged; do
  [ -f "$f" ] || continue
  is_fixture "$f" && continue
  git diff --cached -U0 -- "$f" | grep '^+' | grep -v '^+++' | scan_text "$f" || { [ "$fail" -eq 0 ] && echo "The commit was stopped: it carries something that identifies the machine or its owner." >&2; fail=1; }
done

if [ "$fail" -ne 0 ]; then
  echo >&2
  echo "Put the value in secret.properties (gitignored) and read it through AppSecrets, or write the" >&2
  echo "general case instead of the specific one." >&2
  exit 1
fi
exit 0
