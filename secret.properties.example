# Copy to secret.properties (gitignored) and fill in. The app reads these at build
# time; without them it falls back to the localhost/LAN default and no auth.
ARBAY_SERVER_URL=https://your-server.example
# Non-interactive auth header the app sends on every request (Authelia Basic-auth
# passthrough): "Basic " + base64(user:password). Leave blank for no auth.
ARBAY_AUTH=
