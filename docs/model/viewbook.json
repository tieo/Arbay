          "no": "first only"
        },
        {
          "field": "nativeCriteria",
          "title": "Filters at the source"
        },
        {
          "field": "soldListings",
          "title": "Sold"
        },
        {
          "field": "listingAge",
          "title": "Age"
        },
        {
          "field": "location",
          "title": "Place"
        },
        {
          "field": "crawler",
          "title": "Crawler"
        }
      ]
    }
  ],
  "renders": {
    "command": [
      "./make-renders.sh"
    ],
    "dir": "../..",
